[
  {
    "id": "L01",
    "text": "If your friend never knocks, check the mirror.",
    "pauseAfter": 0.4
  },
  {
    "id": "L02",
    "text": "Remember their first visit?",
    "pauseAfter": 0.32
  },
  {
    "id": "L03",
    "text": "They waited outside, even though the door was open.",
    "pauseAfter": 0.25
  },
  {
    "id": "L04",
    "text": "You laughed.",
    "pauseAfter": 0.2
  },
  {
    "id": "L05",
    "text": "Just come in. You don't have to ask.",
    "pauseAfter": 0.4
  },
  {
    "id": "L06",
    "text": "They never asked again.",
    "pauseAfter": 0.8
  },
  {
    "id": "L07",
    "text": "Last night, you woke with their hand around your wrist.",
    "pauseAfter": 0.55
  },
  {
    "id": "L08",
    "text": "You said I could come in.",
    "pauseAfter": 0.7,
    "whisper": true
  },
  {
    "id": "L09",
    "text": "You reached for the lamp.",
    "pauseAfter": 0.25
  },
  {
    "id": "L10",
    "text": "They held on.",
    "pauseAfter": 0.7
  },
  {
    "id": "L11",
    "text": "In the mirror, your arm was hanging in mid-air.",
    "pauseAfter": 0.4
  },
  {
    "id": "L12",
    "text": "Alone.",
    "pauseAfter": 1.1
  },
  {
    "id": "L13",
    "text": "Then their fingers tightened.",
    "pauseAfter": 0.35,
    "whisper": true
  }
]
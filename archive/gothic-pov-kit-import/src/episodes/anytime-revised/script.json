[
  {
    "id": "L01",
    "text": "Your friend stopped knocking.",
    "pauseAfter": 0.3
  },
  {
    "id": "L02",
    "text": "That's your fault.",
    "pauseAfter": 0.3
  },
  {
    "id": "L03",
    "text": "Remember their first visit?",
    "pauseAfter": 0.3
  },
  {
    "id": "L04",
    "text": "They waited at your open door.",
    "pauseAfter": 0.3
  },
  {
    "id": "L05",
    "text": "You said, come in. Anytime.",
    "pauseAfter": 0.3
  },
  {
    "id": "L06",
    "text": "Now they do.",
    "pauseAfter": 0.3
  },
  {
    "id": "L07",
    "text": "Tonight, you woke with a hand around your wrist.",
    "pauseAfter": 0.3
  },
  {
    "id": "L08",
    "text": "Your friend's voice, inches from your ear.",
    "pauseAfter": 0.3
  },
  {
    "id": "L09",
    "text": "You said anytime.",
    "pauseAfter": 0.3,
    "whisper": true
  },
  {
    "id": "L10",
    "text": "You switched on the lamp.",
    "pauseAfter": 0.3
  },
  {
    "id": "L11",
    "text": "In the mirror, you could see your wrist.",
    "pauseAfter": 0.3
  },
  {
    "id": "L12",
    "text": "But not the hand around it.",
    "pauseAfter": 0.3
  },
  {
    "id": "L13",
    "text": "Then it pulled.",
    "pauseAfter": 0.3,
    "whisper": true
  }
]